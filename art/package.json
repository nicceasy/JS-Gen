{
  "name": "art",
  "private": true,
  "type": "module",
  "description": "Self-contained procedural animations. The pieces need no dependencies; the tools that verify them need a headless browser.",
  "scripts": {
    "verify": "node verify.mjs",
    "scan": "node verify.mjs --scan-only",
    "sheet": "node tools/sheet.mjs",
    "smoke": "node tools/smoke.mjs",
    "audio": "node tools/audio.mjs",
    "ablate": "node tools/ablate.mjs",
    "look": "node tools/look.mjs",
    "decide": "node tools/decide.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
